PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Dùng URL pooled cho API; migration cần URL direct riêng khi bổ sung Drizzle.
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=require
DATABASE_SCHEMA=tlucs
PAYMENT_MODE=simulation
GOOGLE_CLIENT_ID=
JWT_SECRET=replace_with_a_long_random_value
UPLOAD_DIR=./uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
RESEND_API_KEY=
EMAIL_FROM=TLUCS <no-reply@example.com>
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
MAPS_PROVIDER_TOKEN=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_MIN_SIMILARITY=0.68
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
